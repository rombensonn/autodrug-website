NODE_ENV="production"

# Site
NEXT_PUBLIC_SITE_URL="https://example.ru"
NEXT_PUBLIC_SITE_NAME="Авто друг"
NEXT_PUBLIC_SITE_REGION="RU"
NEXT_PUBLIC_DATA_RESIDENCY="RU"
NEXT_PUBLIC_TELEGRAM_URL=""
NEXT_PUBLIC_STATIC_PREVIEW="false"
NEXT_PUBLIC_GITHUB_PAGES_REPOSITORY="autodrug-website"

# Database in Russia
DATABASE_URL="postgresql://autodrug:strong_password@postgres:5432/autodrug?schema=public"

# Admin
ADMIN_PASSWORD="change_me"
SESSION_SECRET="change_me_long_random_string"

# Security
IP_HASH_SALT="change_me_long_random_string"
RATE_LIMIT_WINDOW_SECONDS="300"
RATE_LIMIT_MAX_REQUESTS="5"

# Optional Russian SMTP
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
LEADS_EMAIL_TO="g30107@gmail.com"

# Optional Telegram notice without personal data
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_SEND_PERSONAL_DATA="false"

# Optional CRM only if hosted in Russia
CRM_WEBHOOK_URL=""
CRM_SEND_PERSONAL_DATA="false"

# Analytics
NEXT_PUBLIC_YANDEX_METRICA_ID=""
NEXT_PUBLIC_ENABLE_YANDEX_METRICA="false"
ENABLE_LOCAL_ANALYTICS="true"

# Backups
BACKUP_RETENTION_DAYS="30"
BACKUP_ENCRYPTION_KEY=""
